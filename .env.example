# PromptForge AI Platform — Environment Variables Configuration

# Google AI Studio Gemini API Key (Server-side only)
# Get key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here

# Django Core Settings
SECRET_KEY=django-insecure-promptforge-ai-production-super-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/promptforge_db

# Alternative discrete Database fields
POSTGRES_DB=promptforge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
